; Engine configuration file.
config_version=5

[application]

config/name="dot-Godough"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
run/low_processor_mode=true

[display]

window/size/viewport_width=1440
window/size/viewport_height=880
window/subwindows/embed_subwindows=true

[dotnet]

project/assembly_name="DotGodough"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.925, 0.914, 0.847, 1)
